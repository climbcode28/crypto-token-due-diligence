# Optional RPC configuration for the token-diligence skills.
#
# Copy this file to ~/.config/crypto-research/env (outside any repo), edit the values,
# then `chmod 600 ~/.config/crypto-research/env`. The skills source it in the same shell
# call as each collector run; they never print the values.
#
# EVM: free public endpoint for Robinhood Chain mainnet (chain 4663). Any HTTPS JSON-RPC
# endpoint for the chain you are researching works; the collector verifies eth_chainId.
# (Another variable name can be selected per run with --rpc-url-env.)
export ROBINHOOD_DRPC_URL='https://rpc.mainnet.chain.robinhood.com'

# Solana: optional. The Solana skill defaults to the public mainnet endpoint when unset.
# export SOLANA_RPC_URL='https://api.mainnet-beta.solana.com'

# Only if you personally pay for a dRPC plan. Use the credential-free network URL shape
# (https://lb.drpc.org/<network> or https://lb.drpc.live/<network>) and put the key here
# only; both skills send it as a Drpc-Key header and refuse a URL that carries it.
# A configured key is NOT permission to spend. Authorized paid commands need paid flags
# on every invocation; this does not mean asking again for already-granted user consent.
# Host approval rules still apply. Without paid authorization, use public RPC.
# export ROBINHOOD_DRPC_URL='https://lb.drpc.org/robinhood'
# export SOLANA_DRPC_URL='https://lb.drpc.org/solana'   # optional default for authorized dRPC use
# export DRPC_API_KEY='your-key'
